
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# ---- App / frontend ----
APP_URL=http://localhost:3000

# ---- Postgres ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/twocare_db
# Sync URL used by Alembic migrations
DATABASE_URL_SYNC=postgresql://postgres:postgres@postgres:5432/twocare_db

# ---- Redis (session / call-state / dedupe) ----
REDIS_URL=redis://redis:6379/0

# ---- LLM providers ----
GEMINI_API_KEY=
# OpenAI key for the LiveKit voice worker (STT / LLM / TTS)
OPENAI_API_KEY=

# ---- Voice pipeline provider selection ----
# One of: openai (Realtime API, best EN/HI code-switch support today) | google
STT_LLM_TTS_PROVIDER=openai

# ---- Cliniko PMS ----
CLINIKO_API_KEY=
CLINIKO_SHARD=au4
CLINIKO_BASE_URL=

# ---- Agent worker ----
LIVEKIT_AGENT_HOST=127.0.0.1
LIVEKIT_AGENT_PORT=8081
BACKEND_URL=http://localhost:8000
# Shared secret so only the agent worker can call the tool-calling endpoints
AGENT_SERVICE_TOKEN=generate-a-random-string&&@
TWILIO_PHONE_NUMBER="+"
DEEPGRAM_API_KEY=""
CARTESIA_API_KEY=
GEMINI_MODEL=""